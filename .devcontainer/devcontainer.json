// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/jekyll
{
	"name": "Jekyll",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/jekyll:2-bookworm",
	"features": {
		"ghcr.io/stuartleeks/dev-container-features/shell-history:0": {},
		"ghcr.io/joshuanianji/devcontainer-features/github-cli-persistence:1": {},
		"ghcr.io/devcontainers-extra/features/gh-cli:1": {
			"version": "latest"
		},
		// Required by the dot-config feature below: its installer is a Node.js app
		// and the Jekyll base image ships no Node.js.
		"ghcr.io/devcontainers/features/node:2": {
			"nodeGypDependencies": true,
			"version": "lts",
			"npmVersion": "lts",
			"pnpmVersion": "latest",
			"nvmVersion": "latest"
		},
		"ghcr.io/devcontainer-config/features/dot-config:4": {},
		"ghcr.io/audacioustux/devcontainers/taskfile:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"saoudrizwan.claude-dev"
			]
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// The image installs Jekyll, Bundler and github-pages *as root* during the
	// build, so the subdirectories of GEM_HOME (/usr/local/bundle) are left
	// owned by root:root with mode 755 - only that top-level directory itself
	// is 1777. A `bundle install` running as the non-root "vscode" user
	// therefore fails with
	//   Bundler::PermissionError ... /usr/local/bundle/cache/<gem>.gem
	// whenever the Gemfile needs a gem the image does not ship.
	// Fix it the same way the image itself is being fixed upstream
	// (https://github.com/devcontainers/images/pull/1991): hand the tree to
	// the "ruby" group that "vscode" is already a member of, make it group
	// writable and set the setgid bit on the directories so gems installed
	// later keep inheriting that group.
	// NOTE: postCreateCommand must be a single shell string (joined with &&
	// so each step only runs if the previous one succeeded). The array form
	// is argv for ONE command, not a list of commands, so
	// ["cmd1", "cmd2"] would NOT run two commands.
	"postCreateCommand": "sudo chgrp -R ruby /usr/local/bundle && sudo chmod -R g+rwX /usr/local/bundle && sudo find /usr/local/bundle -type d -exec chmod g+s {} + && bundle install"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
